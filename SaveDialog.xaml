<Window x:Class="PBIScreenshotter.SaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save as Picture" Height="650" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3"
        WindowStyle="None" AllowsTransparency="True" BorderThickness="1" BorderBrush="#CCC">
    <Border Background="White" CornerRadius="12" Margin="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.1"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="🖼️" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Save as Picture" FontSize="22" FontWeight="Bold" Foreground="#111"/>
                    <TextBlock Text="Review your visual and choose a save option" FontSize="13" Foreground="#666"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#999"
                        Click="Close_Click" Margin="580,0,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#F8F8F8" CornerRadius="8" BorderBrush="#EEE" BorderThickness="1">
                <Image x:Name="PreviewImage" Margin="20" Stretch="Uniform">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                    </Image.Effect>
                </Image>
            </Border>

            <Grid Grid.Row="2" Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ComboBox x:Name="FormatSelector" Width="100" Height="40" VerticalContentAlignment="Center" Margin="0,0,10,0">
                        <ComboBoxItem Content="PNG" IsSelected="True"/>
                        <ComboBoxItem Content="JPG"/>
                        <ComboBoxItem Content="BMP"/>
                        <ComboBoxItem Content="SVG"/>
                    </ComboBox>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="100" Height="40" Margin="0,0,12,0" 
                            Background="Transparent" BorderBrush="#999" BorderThickness="1" Foreground="#666"
                            FontWeight="SemiBold" Click="Close_Click"/>
                    <Button Content="Copy to Clipboard" Width="160" Height="40" Margin="0,0,12,0" 
                            Background="White" BorderBrush="#0078D4" BorderThickness="1" Foreground="#0078D4"
                            FontWeight="SemiBold" Click="Copy_Click"/>
                    <Button Content="Save Image" Width="160" Height="40" 
                            Background="#0078D4" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
