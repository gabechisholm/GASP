<Window x:Class="PBIScreenshotter.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GASP - Setup" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterScreen" Background="#F8F9FA"
        WindowStyle="None" AllowsTransparency="True" BorderThickness="1" BorderBrush="#DEE2E6"
        StateChanged="Window_StateChanged">
    <Border CornerRadius="12" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.05"/>
        </Border.Effect>
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,5,0,20">
                <Image Source="assets\baedc91c-cc61-4b6d-9d6c-76f0c747ae7f.png" Width="120" Height="120" HorizontalAlignment="Center"/>
                <TextBlock Text="GASP" FontSize="48" FontWeight="ExtraBold" Foreground="#212529" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock Text="Gabe's Amazing Screenshot Program" FontSize="11" Foreground="#6C757D" HorizontalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Settings Area -->
            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <Border Background="#F1F3F5" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="DETECTION SETTINGS" FontSize="9" FontWeight="Bold" Foreground="#ADB5BD" Margin="0,0,0,12"/>
                        
                        <TextBlock Text="Target Selection Hex" FontSize="11" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,5"/>
                        <TextBox x:Name="HexInput" Text="#C8C8C8" Padding="8" Margin="0,0,0,15" Background="White" BorderBrush="#DEE2E6" FontSize="12"/>

                        <DockPanel LastChildFill="True" Margin="0,0,0,5">
                            <TextBlock Text="Color Tolerance" FontSize="11" FontWeight="SemiBold" Foreground="#495057"/>
                            <TextBlock x:Name="ToleranceText" Text="0%" HorizontalAlignment="Right" Foreground="#0078D4" FontWeight="Bold"/>
                        </DockPanel>
                        <Slider x:Name="ToleranceSlider" Minimum="0" Maximum="50" Value="0" 
                                TickFrequency="1" IsSnapToTickEnabled="True" 
                                ValueChanged="ToleranceSlider_ValueChanged" Margin="0,0,0,5"/>
                    </StackPanel>
                </Border>

                <Border Background="#F1F3F5" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="PREFERENCES" FontSize="9" FontWeight="Bold" Foreground="#ADB5BD" Margin="0,0,0,12"/>
                        
                        <RadioButton x:Name="RadioSave" Content="Save to File (Default)" IsChecked="True" Margin="0,0,0,10" FontSize="12" Foreground="#495057"/>
                        <RadioButton x:Name="RadioClipboard" Content="Instant Copy to Clipboard" Margin="0,0,0,12" FontSize="12" Foreground="#495057"/>
                        
                        <Separator Background="#DEE2E6" Margin="0,0,0,12"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Hotkey:" FontSize="11" FontWeight="SemiBold" Foreground="#495057"/>
                            <TextBlock Text=" Alt + S" FontSize="11" Foreground="#0078D4" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Margin="0,0,0,0">
                <Button x:Name="InstallButton" Content="Install &amp; Save Config" Height="45" 
                        Background="#0078D4" Foreground="White" FontSize="14" FontWeight="Bold"
                        BorderThickness="0" Margin="0,0,0,10" Click="Install_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Minimize to Tray" Height="35" Background="#E9ECEF" BorderThickness="0" 
                            Foreground="#495057" FontWeight="SemiBold" FontSize="12" Click="Minimize_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Grid.Column="2" Content="Exit" Height="35" Background="Transparent" BorderBrush="#DEE2E6" BorderThickness="1" 
                            Foreground="#6C757D" FontWeight="SemiBold" FontSize="12" Click="Close_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row="3" Text="Developed by Gabe Chisholm @ SynapsysIQ" 
                       HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="9" Foreground="#ADB5BD" FontWeight="Medium"/>
        </Grid>
    </Border>
</Window>
