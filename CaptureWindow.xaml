<Window x:Class="PBIScreenshotter.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture" Height="450" Width="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowState="Maximized" ShowInTaskbar="False"
        Cursor="Cross" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Storyboard x:Key="SeekerAnimation">
            <DoubleAnimation Storyboard.TargetName="HighlightBorder" Storyboard.TargetProperty="Width" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HighlightBorder" Storyboard.TargetProperty="Height" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="(Canvas.Left)" Storyboard.TargetProperty="X" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="(Canvas.Top)" Storyboard.TargetProperty="Y" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    <Grid Background="#01FFFFFF" MouseMove="Window_MouseMove" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <!-- Detection Layer -->
            <Canvas x:Name="DetectionBordersCanvas" IsHitTestVisible="False"/>

            <!-- The Seeker Border -->
            <Border x:Name="HighlightBorder" BorderBrush="#0078D4" BorderThickness="3" 
                    Background="#1A0078D4" Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="HighlightTransform"/>
                </Border.RenderTransform>
            </Border>

            <!-- Tooltip -->
            <Border x:Name="ActionTooltip" Background="#F3F3F3" Padding="8,4" CornerRadius="4" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <TextBlock Text="🎯 Click to Snap to Visual" FontSize="12" FontWeight="SemiBold" Foreground="#333"/>
            </Border>
        </Canvas>
    </Grid>
</Window>
